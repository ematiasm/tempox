# Credentials and settings for the deliverable stack.
#
# Copy this to `.env.prod`, fill in real values, and keep it out of the
# repository — `.env.prod` is git-ignored and must never be committed.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# `--env-file` is not decoration. Measured: without it, Compose reads the
# development `.env`, which holds `changethis`, and the compose file's `${VAR:?}`
# guards do not catch it because the variable IS present, just wrong. That is why
# these are named `PROD_*`: the development `.env` cannot satisfy them.
#
# The values below are placeholders. `PROD_POSTGRES_PASSWORD` has no default
# anywhere in `docker-compose.prod.yml`: Compose refuses to start without it.

# ─── PostgreSQL ──────────────────────────────────────────────────────
# Used to initialize the volume on first boot and to compose the backend's
# DATABASE_URL. Changing them after the volume exists does NOT rename the role:
# an existing volume keeps the credentials it was born with.
PROD_POSTGRES_USER=tempox
PROD_POSTGRES_PASSWORD=change-me-before-deploying
PROD_POSTGRES_DB=tempox

# ─── Backend ─────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error
RUST_LOG=info

# The IANA timezone the shop works in. `/api/day` answers from this zone, never
# from the browser's clock, so a machine set to UTC cannot move the shop's day.
SHOP_TIMEZONE=America/Argentina/Buenos_Aires

# ─── Frontend ────────────────────────────────────────────────────────
# The host port the frontend is published on. The container always listens on
# 5173; this is only the outside of the mapping.
FRONTEND_PORT=5173

# `BACKEND_URL` is deliberately NOT here. It is set in
# `docker-compose.prod.yml` to `http://backend:3001`, because it names a service
# on the Compose network rather than anything specific to a deployment.
