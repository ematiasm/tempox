# ─── Backend (Rust / Axum) ───────────────────────────────────────────
# PostgreSQL connection string used by sqlx.
DATABASE_URL=postgres://skilluv:skilluv@postgres:5432/skilluv

# Port the Axum server listens on inside the container.
BACKEND_PORT=3001

# Log level: trace | debug | info | warn | error
RUST_LOG=info

# ─── Frontend (SvelteKit) ────────────────────────────────────────────
# Public base URL of the backend as seen from the browser.
# In dev with docker-compose, use http://localhost:3001.
PUBLIC_API_BASE=http://localhost:3001

# Port Vite dev server listens on.
FRONTEND_PORT=5173

# ─── PostgreSQL (docker-compose service) ─────────────────────────────
POSTGRES_USER=skilluv
POSTGRES_PASSWORD=skilluv
POSTGRES_DB=skilluv
POSTGRES_PORT=5432

# ─── Shop configuration ─────────────────────────────────────────────
# The IANA timezone the shop works in. "Today" is a local calendar day, and the
# backend answers `/api/day` from this zone — never from the browser's clock,
# which carries whatever timezone the machine was installed with.
SHOP_TIMEZONE=America/Argentina/Buenos_Aires
