  "query": "SELECT p.id, p.supplier_id, p.payment_method_id,\n                pm.name AS \"payment_method_name!\",\n                round(p.total, 2) AS \"total!\", p.created_at\n         FROM purchases p\n         JOIN payment_methods pm ON pm.id = p.payment_method_id\n         WHERE p.id = $1",
