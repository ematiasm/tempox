{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.name, p.list_price, p.unit, p.created_at,\n                COALESCE(SUM(m.quantity), 0)::bigint AS \"stock!\"\n         FROM products p\n         LEFT JOIN stock_movements m ON m.product_id = p.id\n         WHERE p.id = $1\n         GROUP BY p.id",
