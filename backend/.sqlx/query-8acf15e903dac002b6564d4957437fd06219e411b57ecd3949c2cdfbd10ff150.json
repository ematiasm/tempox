  "query": "SELECT id, supplier_id, round(total, 2) AS \"total!\", created_at\n         FROM purchases\n         WHERE ($1::timestamptz IS NULL OR created_at >= $1)\n           AND ($2::timestamptz IS NULL OR created_at < $2)\n         ORDER BY created_at DESC\n         LIMIT $3 OFFSET $4",
