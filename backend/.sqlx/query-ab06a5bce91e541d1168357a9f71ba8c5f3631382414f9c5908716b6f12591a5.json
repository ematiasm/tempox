{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id, s.customer_id, round(s.total, 2) AS \"total!\",\n                s.payment_method_id,\n                CASE WHEN s.payment_method_id IS NULL THEN NULL ELSE pm.name END\n                    AS \"payment_method_name\",\n                s.created_at\n         FROM sales s\n         LEFT JOIN payment_methods pm ON pm.id = s.payment_method_id\n         WHERE s.id = $1",
