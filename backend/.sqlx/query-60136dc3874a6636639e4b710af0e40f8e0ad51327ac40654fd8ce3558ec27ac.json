  "query": "SELECT s.id, s.customer_id, round(s.total, 2) AS \"total!\",\n                pm.name AS \"payment_method!\", s.status,\n                s.reversed_at, s.created_at\n         FROM sales s\n         JOIN payment_methods pm ON pm.id = s.payment_method_id\n         WHERE s.id = $1",
