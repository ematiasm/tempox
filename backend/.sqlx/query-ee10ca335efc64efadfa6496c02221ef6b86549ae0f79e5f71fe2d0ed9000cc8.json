{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.name, p.list_price, p.unit, p.created_at,\n                  COALESCE(SUM(m.quantity), 0)::bigint AS \"stock!\"\n           FROM products p\n           LEFT JOIN stock_movements m ON m.product_id = p.id\n           WHERE ($1::text IS NULL OR p.name ILIKE '%' || $1 || '%' ESCAPE '\\')\n           GROUP BY p.id\n           ORDER BY p.name\n           LIMIT $2 OFFSET $3",
